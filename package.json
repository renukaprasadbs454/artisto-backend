{
  "name": "artisto-backend",
  "version": "1.0.0",
  "description": "Artisto freelance services marketplace — backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "migrate:prod": "npx prisma db execute --schema prisma/schema.prisma --file prisma/migrations/20260804_rename-actor-tables-to-explore/migration.sql && npx prisma db push --skip-generate",
    "prisma:studio": "npx prisma studio",
    "prisma:seed": "npx prisma db seed",
    "create-admin": "ts-node ./scripts/create-admin.ts"
  },
  "dependencies": {
    "@prisma/client": "^7.9.1",
    "@supabase/supabase-js": "^2.110.7",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.0",
    "@types/swagger-ui-express": "^4.1.7",
    "argon2": "^0.45.1",
    "axios": "^1.7.9",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2",
    "razorpay": "^2.9.8",
    "socket.io": "^4.8.0",
    "swagger-ui-express": "^5.0.1",
    "vitest": "^4.1.10",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "prisma": "^7.9.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.0"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
