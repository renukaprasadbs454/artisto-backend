# Example environment variables for local development
# Copy this to `.env` and set appropriate values. DO NOT commit real secrets.

# Server
NODE_ENV=development    # Set to 'production' in production
PORT=4000

# Postgres connection string used by Prisma (development)
# Example: postgresql://user:password@localhost:5432/artisto_dev
DATABASE_URL=

# MASTER_ADMIN_KEY: used by backend-only scripts (create-admin). Keep secret.
MASTER_ADMIN_KEY=replace-with-a-strong-random-value

# JWT keys/secrets
# Either provide RSA keys (preferred) or symmetric secrets.
# For RSA: set JWT_ACCESS_PRIVATE_KEY and JWT_ACCESS_PUBLIC_KEY (multiline, replace newlines with \n when setting in some UIs)
JWT_ACCESS_PRIVATE_KEY=
JWT_ACCESS_PUBLIC_KEY=
# Or for HS256 symmetric signing:
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-secret

# Token expiries
ACCESS_TOKEN_EXPIRY=15m
PASSWORD_RESET_TOKEN_EXPIRY=15m
# Refresh expiry in milliseconds (defaults to 30 days)
REFRESH_TOKEN_EXPIRY_MS=

# Cookie SameSite behaviour for refresh cookie (production should usually be 'none')
REFRESH_COOKIE_SAMESITE=none

# Argon2 parameters (optional tuning)
ARGON_TIME=3
ARGON_MEMORY=65536
ARGON_PARALLELISM=1

# Third-party services
# Supabase (optional; used for storage)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_STORAGE_BUCKET=artisto-uploads

# TMDb API key (optional)
TMDB_API_KEY=

# Razorpay (optional; payment provider)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Web sockets / frontend integration
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:4000/api/v1
VITE_WS_URL=http://localhost:4000

# Optional master/third-party keys used by scripts
MASTER_ADMIN_KEY=replace-with-a-strong-random-value

# NOTES:
# - Never commit `.env` to version control. Use `.env.example` as a template only.
# - In production (Render, Vercel, Railway), set these values in the platform's environment UI.
# - For RSA keys in platform UIs, replace actual newlines with the literal sequence `\n` if the UI doesn't allow multiline values.