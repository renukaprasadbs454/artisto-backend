# Example environment variables for local development
# Copy this to .env and set appropriate values. DO NOT commit real secrets.

# Postgres connection string used by Prisma
DATABASE_URL=postgresql://user:password@localhost:5432/artisto_dev

# A server-only master key used to authorize admin creation via CLI.
# Must be set on the server and never exposed to the frontend or client bundles.
MASTER_ADMIN_KEY=kwiko-aristo-admin-@2026
# Server
PORT=4000

# Database — Supabase Postgres connection string
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# JWT secrets — use two DIFFERENT secrets
JWT_ACCESS_SECRET=your-access-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here

# Supabase Storage (replaces AWS S3)
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key
SUPABASE_STORAGE_BUCKET=artisto-uploads

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Optional; defaults to 15m
PASSWORD_RESET_TOKEN_EXPIRY=15m

# TMDb API Key (for actor profiles & movie search)
TMDB_API_KEY=your_tmdb_api_key_here